<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Poonam &amp; Rahul · 25 November 2026</title>
<meta name="description" content="You're invited to the wedding of Poonam & Rahul — 25 November 2026, VG Salasar Garden, New Delhi">
<meta name="theme-color" content="#5a0b16">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Cinzel:wght@400;600&family=Tiro+Devanagari+Hindi:ital@0;1&family=Kalam:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{
  --maroon:#5a0b16; --crimson:#8e1426; --rose:#c2405a; --blush:#f6d3d6; --petal:#f9e4e3;
  --ivory:#fff8f0; --cream:#fbefe2; --gold:#c9a24b; --gold-l:#ecd28c; --gold-d:#9a7425;
  --ink:#4a1a1f; --ink-soft:#7a4a4e;
  --script:'Great Vibes',cursive; --serif:'Cormorant Garamond',Georgia,serif; --caps:'Cinzel',serif;
  --hindi:'Tiro Devanagari Hindi',serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  font-family:var(--serif); color:var(--ink); overflow-x:hidden;
  background:
    radial-gradient(1200px 700px at 10% -10%, #ffe3e3 0%, transparent 60%),
    radial-gradient(900px 600px at 110% 20%, #fbd6cf 0%, transparent 55%),
    radial-gradient(900px 700px at 50% 120%, #f3c6c2 0%, transparent 60%),
    linear-gradient(180deg,#fdf1ea 0%, #f9e2dc 50%, #f6d9d3 100%);
  background-attachment:fixed;
  -webkit-font-smoothing:antialiased;
}
body.locked{overflow:hidden}
[lang-hi]{display:none}
body.hi [lang-en]{display:none}
body.hi [lang-hi]{display:revert}
body.hi .hi-font, .hindi{font-family:var(--hindi)}

/* ---------- floating layers ---------- */
#sparkles{position:fixed;inset:0;pointer-events:none;z-index:2}
#petals{position:fixed;inset:0;pointer-events:none;z-index:3;overflow:hidden}
.petal{
  position:absolute; top:-40px; width:18px; height:22px; opacity:.85;
  background:radial-gradient(circle at 30% 30%, #ffd9df 0%, #e58ea0 45%, #b5304b 100%);
  border-radius:150% 0 150% 0; filter:drop-shadow(0 2px 2px rgba(90,11,22,.18));
  animation:fall linear forwards;
}
.petal.light{background:radial-gradient(circle at 30% 30%, #fff 0%, #f8cdd4 50%, #e79aaa 100%)}
@keyframes fall{
  0%{transform:translate3d(0,-5vh,0) rotate(0deg) rotateY(0)}
  25%{transform:translate3d(var(--sway),25vh,0) rotate(90deg) rotateY(160deg)}
  50%{transform:translate3d(calc(var(--sway)*-0.6),55vh,0) rotate(180deg) rotateY(320deg)}
  100%{transform:translate3d(var(--sway),110vh,0) rotate(360deg) rotateY(720deg)}
}

/* ---------- ENVELOPE / INTRO ---------- */
#intro{position:fixed;inset:0;z-index:50;perspective:1600px;cursor:pointer}
.door{
  position:absolute; top:0; bottom:0; width:50.2%;
  background:
    radial-gradient(120% 80% at 50% 50%, rgba(255,255,255,.07), transparent 60%),
    repeating-linear-gradient(115deg, rgba(255,255,255,.025) 0 2px, transparent 2px 6px),
    radial-gradient(140% 100% at 50% 40%, #a3172d 0%, #7a0f20 45%, #4a0612 100%);
  transition:transform 1.8s cubic-bezier(.7,0,.2,1), filter 1.8s;
  overflow:hidden;
}
.door.left{left:0; transform-origin:left center; box-shadow:inset -8px 0 18px rgba(0,0,0,.35)}
.door.right{right:0; transform-origin:right center; box-shadow:inset 8px 0 18px rgba(0,0,0,.35)}
.door svg.lines{position:absolute; inset:0; width:200%; height:100%}
.door.right svg.lines{left:-100%}
#intro.open .door.left{transform:rotateY(-105deg); filter:brightness(.6)}
#intro.open .door.right{transform:rotateY(105deg); filter:brightness(.6)}
#intro.gone{display:none}

.corner-roses{position:absolute; width:min(52vw,320px); pointer-events:none}
.corner-roses.tl{top:-30px; left:-40px}
.corner-roses.br{bottom:-30px; right:-40px; transform:rotate(180deg)}
.corner-roses.tr{top:-40px; right:-50px; width:min(36vw,220px); transform:scaleX(-1) rotate(10deg); opacity:.9}
.corner-roses.bl{bottom:-40px; left:-50px; width:min(36vw,220px); transform:rotate(190deg) scaleX(-1); opacity:.9}

.intro-center{
  position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;
  z-index:5; pointer-events:none; text-align:center; color:var(--gold-l);
  transition:opacity .9s ease;
}
#intro.open .intro-center{opacity:0}
.intro-center .kicker{font-family:var(--caps); letter-spacing:.42em; font-size:clamp(12px,3.4vw,15px); text-shadow:0 0 12px rgba(255,214,140,.5)}
.intro-center .tag{font-family:var(--caps); letter-spacing:.32em; font-size:clamp(11px,3vw,13px); margin-top:4px}
.seal-wrap{position:relative; width:min(78vw,380px); height:min(78vw,380px); margin:14px 0 6px}
.bow{position:absolute; inset:0; width:100%; height:100%; filter:drop-shadow(0 10px 18px rgba(0,0,0,.45))}
.seal{
  position:absolute; left:50%; top:50%; width:36%; aspect-ratio:1; transform:translate(-50%,-50%);
  border-radius:50%; pointer-events:auto; cursor:pointer;
  background:
    radial-gradient(circle at 35% 30%, #fff6dc 0%, #f1d49a 30%, #d2a95c 60%, #a57a31 100%);
  box-shadow: 0 6px 16px rgba(0,0,0,.45), inset 0 -6px 12px rgba(120,80,20,.5), inset 0 6px 10px rgba(255,255,255,.6);
  display:grid; place-items:center;
  animation:sealPulse 2.6s ease-in-out infinite;
  transition:transform .9s cubic-bezier(.5,-0.4,.3,1.4), opacity .9s;
}
.seal::before{ /* irregular wax rim */
  content:""; position:absolute; inset:-7%; border-radius:47% 53% 49% 51% / 52% 46% 54% 48%;
  background:radial-gradient(circle at 40% 30%, #f3d9a6, #b88a3e 70%, #8d6424);
  z-index:-1; box-shadow:0 4px 10px rgba(0,0,0,.35);
}
.seal::after{content:""; position:absolute; inset:9%; border-radius:50%; border:1.5px solid rgba(120,80,25,.55); box-shadow:inset 0 0 0 4px rgba(255,240,200,.25)}
.seal .mono{white-space:nowrap; font-family:var(--script); color:#7d5518; font-size:clamp(30px,9vw,46px); line-height:1; text-shadow:0 1px 0 rgba(255,255,255,.65), 0 -1px 0 rgba(90,55,10,.35)}
.seal .mono small{font-family:var(--serif); font-size:.38em; vertical-align:middle; margin:0 2px}
@keyframes sealPulse{0%,100%{transform:translate(-50%,-50%) scale(1)}50%{transform:translate(-50%,-50%) scale(1.05)}}
#intro.open .seal{transform:translate(-50%,-50%) scale(1.7) rotate(25deg); opacity:0; animation:none}
#intro.open .bow{transition:opacity .7s, transform 1s; opacity:0; transform:scale(1.2)}
.tap{
  margin-top:16px; font-family:var(--serif); font-style:italic; color:#ffe9c0; font-size:clamp(15px,4vw,18px);
  animation:tapBlink 2.2s ease-in-out infinite; letter-spacing:.04em
}
.tap .hand{display:inline-block; animation:tapHand 1.4s ease-in-out infinite}
@keyframes tapBlink{0%,100%{opacity:.55}50%{opacity:1}}
@keyframes tapHand{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
.names-intro{font-family:var(--script); font-size:clamp(28px,8vw,40px); color:#ffe0a8; margin-top:10px; text-shadow:0 2px 14px rgba(255,190,110,.55)}

/* ---------- MAIN ---------- */
main{position:relative; z-index:4; max-width:560px; margin:0 auto; padding:28px 16px 80px; opacity:0; transition:opacity 1.4s ease .3s}
body.revealed main{opacity:1}

.lang-toggle{
  position:fixed; top:14px; right:14px; z-index:40; display:flex; border-radius:999px; overflow:hidden;
  background:rgba(255,248,240,.85); backdrop-filter:blur(8px); border:1px solid rgba(201,162,75,.6);
  box-shadow:0 4px 14px rgba(90,11,22,.15); opacity:0; transition:opacity 1s 1s;
}
body.revealed .lang-toggle{opacity:1}
.lang-toggle button{border:0; background:transparent; padding:8px 14px; font-family:var(--serif); font-size:15px; color:var(--ink); cursor:pointer}
.lang-toggle button.on{background:linear-gradient(135deg,var(--crimson),var(--maroon)); color:#fff1d6}

.card{
  position:relative; margin:26px 0; padding:44px 26px 34px; text-align:center;
  background:
    radial-gradient(120% 60% at 50% 0%, rgba(255,255,255,.95), rgba(255,250,244,.88)),
    linear-gradient(#fffaf4,#fdf0e8);
  border-radius:24px; box-shadow:0 18px 40px rgba(122,15,32,.14), 0 2px 0 rgba(255,255,255,.8) inset;
  opacity:0; transform:translateY(40px) scale(.98); transition:opacity 1s ease, transform 1s cubic-bezier(.2,.7,.2,1);
}
.card.in{opacity:1; transform:none}
.card::before{ content:""; position:absolute; inset:9px; border-radius:18px; border:1px solid rgba(201,162,75,.55); pointer-events:none }
.card::after{ content:""; position:absolute; inset:14px; border-radius:15px; border:1px dashed rgba(201,162,75,.25); pointer-events:none }
.card.arch{ border-radius:999px 999px 26px 26px; padding-top:86px }
.card.arch::before{ border-radius:999px 999px 20px 20px }
.card.arch::after{ border-radius:999px 999px 16px 16px }
.card .rose-deco{position:absolute; width:120px; pointer-events:none; filter:drop-shadow(0 6px 8px rgba(90,11,22,.25))}
.card .rose-deco.tl{top:-34px; left:-26px}
.card .rose-deco.br{bottom:-34px; right:-26px; transform:rotate(170deg)}
.card .rose-deco.tr{top:-30px; right:-22px; transform:scaleX(-1); width:100px}

.ganesh{
  width:70px; height:70px; margin:0 auto 8px; color:var(--crimson);
}
.om-line{font-family:var(--hindi); color:var(--crimson); font-size:18px; letter-spacing:.05em}
.shloka{font-family:var(--hindi); color:var(--ink-soft); font-size:16px; line-height:1.9; margin-top:10px}
.divider{display:flex; align-items:center; gap:10px; justify-content:center; margin:18px auto; color:var(--gold); width:80%}
.divider::before,.divider::after{content:""; flex:1; height:1px; background:linear-gradient(90deg,transparent,var(--gold),transparent)}
.divider span{font-size:14px}

.monogram{
  width:96px; height:96px; margin:0 auto 6px; border-radius:50%; display:grid; place-items:center; position:relative;
  border:1.5px solid var(--gold); color:var(--gold-d); font-family:var(--script); font-size:40px; white-space:nowrap;
  background:radial-gradient(circle,#fffaf0,#f8ead6);
}
.monogram::before{content:""; position:absolute; inset:5px; border-radius:50%; border:1px solid rgba(201,162,75,.5)}
.small-caps{font-family:var(--caps); letter-spacing:.28em; font-size:12px; color:var(--rose)}
body.hi .small-caps{font-family:var(--hindi); letter-spacing:.06em; font-size:15px}
.names{font-family:var(--script); color:var(--maroon); font-size:clamp(54px,15vw,78px); line-height:1.05; margin:8px 0 2px; text-shadow:0 2px 0 rgba(255,255,255,.8)}
.names .amp{display:block; font-family:var(--serif); font-style:italic; font-size:.38em; color:var(--gold-d); margin:2px 0}
body.hi .names{font-family:var(--hindi); font-size:clamp(44px,12vw,62px); line-height:1.3}
.date-big{font-family:var(--caps); color:var(--crimson); letter-spacing:.18em; font-size:16px; margin-top:12px}
body.hi .date-big{font-family:var(--hindi); letter-spacing:.04em; font-size:19px}
.date-row{display:flex; align-items:center; justify-content:center; gap:14px; margin-top:16px; color:var(--maroon)}
.date-row .side{font-family:var(--caps); letter-spacing:.2em; font-size:12px; padding:6px 0; border-top:1px solid var(--gold); border-bottom:1px solid var(--gold); min-width:90px}
.date-row .day{font-family:var(--serif); font-size:58px; font-weight:500; line-height:1; color:var(--crimson)}
body.hi .date-row .side{font-family:var(--hindi); letter-spacing:.03em; font-size:15px}

h2.title{font-family:var(--script); font-weight:400; color:var(--maroon); font-size:clamp(42px,11vw,56px); line-height:1.1}
body.hi h2.title{font-family:var(--hindi); font-size:clamp(30px,8vw,38px)}
p.lead{font-size:19px; line-height:1.65; color:var(--ink-soft); margin-top:10px}
body.hi p.lead{font-size:18px; line-height:1.9}
.person{margin-top:20px}
.person .who{font-family:var(--script); font-size:44px; color:var(--crimson); line-height:1.1}
body.hi .person .who{font-family:var(--hindi); font-size:32px}
.person .rel{font-style:italic; color:var(--ink-soft); font-size:17px; margin-top:4px; line-height:1.55}
body.hi .person .rel{font-style:normal; font-size:16px}
.person .heart{color:var(--rose); margin:16px 0 0; font-size:22px}

/* calendar */
.calendar{
  margin:22px auto 6px; max-width:340px; padding:14px 12px 10px; border-radius:16px;
  background:linear-gradient(180deg,rgba(255,255,255,.75),rgba(252,236,232,.75));
  border:1px solid rgba(201,162,75,.45); box-shadow:inset 0 1px 0 #fff, 0 6px 16px rgba(122,15,32,.08);
}
.cal-month{font-family:var(--caps); letter-spacing:.25em; font-size:15px; color:var(--maroon); margin-bottom:10px}
body.hi .cal-month{font-family:var(--hindi); letter-spacing:.05em; font-size:18px}
.cal-grid{display:grid; grid-template-columns:repeat(7,1fr); gap:4px; font-size:15px}
.cal-grid .dow{font-family:var(--caps); font-size:10px; letter-spacing:.08em; color:var(--rose); padding-bottom:4px}
body.hi .cal-grid .dow{font-family:var(--hindi); font-size:12px; letter-spacing:0}
.cal-grid .d{position:relative; aspect-ratio:1; display:grid; place-items:center; color:var(--ink); border-radius:50%}
.cal-grid .d.wed{color:transparent}
.cal-grid .d .hz{position:absolute; inset:-2px; display:grid; place-items:center; color:var(--rose); font-size:26px; transition:transform .6s cubic-bezier(.5,-.5,.3,1.6), opacity .5s}
.cal-grid .d .num{position:absolute; inset:0; display:grid; place-items:center; color:#fff7e6; font-weight:600; opacity:0; transform:scale(.2); transition:all .7s cubic-bezier(.3,1.6,.4,1) .15s; border-radius:50%;
  background:radial-gradient(circle at 35% 30%, #e45f78, var(--crimson) 60%, var(--maroon)); box-shadow:0 0 0 3px #fff, 0 0 0 4.5px var(--gold), 0 6px 14px rgba(142,20,38,.45)}
.calendar.revealed .d.wed .hz{transform:scale(2.4); opacity:0}
.calendar.revealed .d.wed .num{opacity:1; transform:scale(1.12)}
.calendar:not(.revealed) .d.wed .hz{animation:heartBeat 1.3s ease-in-out infinite}
@keyframes heartBeat{0%,100%{transform:scale(1)}15%{transform:scale(1.2)}30%{transform:scale(1)}45%{transform:scale(1.15)}}

.btn{
  display:flex; align-items:center; justify-content:center; gap:10px; width:100%; max-width:320px; margin:12px auto 0;
  padding:13px 18px; border-radius:999px; font-family:var(--serif); font-size:18px; font-weight:500; color:var(--maroon);
  text-decoration:none; cursor:pointer; border:1px solid rgba(201,162,75,.7);
  background:linear-gradient(180deg,#fffaf3,#f8e6dc); box-shadow:0 1px 0 #fff inset, 0 6px 14px rgba(122,15,32,.12);
  transition:transform .2s, box-shadow .2s;
}
.btn:hover{transform:translateY(-2px); box-shadow:0 1px 0 #fff inset, 0 10px 20px rgba(122,15,32,.18)}
.btn.primary{color:#fff3d9; border-color:transparent; background:linear-gradient(135deg,#b3243d,var(--crimson) 45%,var(--maroon)); box-shadow:0 8px 20px rgba(122,15,32,.35), inset 0 1px 0 rgba(255,255,255,.25)}
.btn svg{width:20px; height:20px; flex:none}
body.hi .btn{font-family:var(--hindi); font-size:17px}

/* countdown */
.countdown{display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:20px}
.cd{padding:14px 4px 10px; border-radius:16px; background:linear-gradient(160deg,#9b1830,var(--maroon)); color:#ffe9c2; box-shadow:0 8px 18px rgba(90,11,22,.3), inset 0 0 0 1px rgba(236,210,140,.35)}
.cd b{display:block; font-family:var(--serif); font-size:clamp(28px,8vw,38px); font-weight:500; line-height:1}
.cd span{font-family:var(--caps); font-size:9.5px; letter-spacing:.18em; opacity:.85}
body.hi .cd span{font-family:var(--hindi); font-size:13px; letter-spacing:0}

.venue-name{font-family:var(--serif); font-size:28px; font-weight:600; color:var(--maroon); margin-top:12px}
body.hi .venue-name{font-family:var(--hindi); font-size:26px}
.venue-addr{color:var(--ink-soft); font-size:17px; line-height:1.6; margin-top:6px}
.pin{width:54px; height:54px; margin:0 auto; color:var(--crimson)}

.closing .couplet{font-family:var(--hindi); color:var(--crimson); font-size:19px; line-height:1.9}
.closing .from{font-family:var(--script); font-size:40px; color:var(--maroon); margin-top:14px; line-height:1.15}
body.hi .closing .from{font-family:var(--hindi); font-size:26px; line-height:1.5}
.closing .with{font-style:italic; color:var(--ink-soft); font-size:18px}

.footer-note{text-align:center; font-family:var(--caps); font-size:11px; letter-spacing:.3em; color:var(--rose); margin-top:30px; opacity:.8}

.burst{position:fixed; pointer-events:none; z-index:60; font-size:18px; animation:burst 1.4s ease-out forwards}
@keyframes burst{to{transform:translate(var(--dx),var(--dy)) rotate(var(--r)) scale(.4); opacity:0}}

@media (prefers-reduced-motion:reduce){
  .petal,.seal,.tap,.tap .hand{animation:none!important}
  .door{transition-duration:.6s}
}
</style>
</head>
<body class="locked">

