<script>
(function(){
  /* ---------- bouquets ---------- */
  const tpl = document.getElementById('bouquet').innerHTML;
  document.querySelectorAll('[data-bouquet]').forEach(el=>{
    const red = el.dataset.bouquet === 'red';
    el.innerHTML = tpl.replaceAll('#ROSE_A', red ? '#roseHeadRed' : '#roseHeadPink')
                      .replaceAll('#ROSE_B', red ? '#roseHeadPink' : '#roseHeadRed');
  });

  /* ---------- links ---------- */
  const venue = 'VG Salasar Garden, Nathan Vihar, Ranholla, Nangloi, Najafgarh Road, New Delhi 110041';
  const q = encodeURIComponent(venue);
  document.getElementById('mapBtn').href = 'https://www.google.com/maps/search/?api=1&query=' + q;
  document.getElementById('dirBtn').href = 'https://www.google.com/maps/dir/?api=1&destination=' + q;
  document.getElementById('calBtn').href = 'https://calendar.google.com/calendar/render?action=TEMPLATE'
    + '&text=' + encodeURIComponent('Poonam & Rahul — Wedding')
    + '&dates=20261125/20261126'
    + '&details=' + encodeURIComponent('With love, All Chahar Family & Friends')
    + '&location=' + q;

  /* ---------- language ---------- */
  document.querySelectorAll('.lang-toggle button').forEach(b=>{
    b.addEventListener('click',()=>{
      document.querySelectorAll('.lang-toggle button').forEach(x=>x.classList.toggle('on', x===b));
      document.body.classList.toggle('hi', b.dataset.lang==='hi');
      buildCalendar();
    });
  });

  /* ---------- calendar ---------- */
  const grid = document.getElementById('calGrid');
  function buildCalendar(){
    const hi = document.body.classList.contains('hi');
    const dows = hi ? ['रवि','सोम','मंगल','बुध','गुरु','शुक्र','शनि'] : ['SUN','MON','TUE','WED','THU','FRI','SAT'];
    let html = dows.map(d=>`<div class="dow">${d}</div>`).join('');
    const first = new Date(2026,10,1).getDay();
    for(let i=0;i<first;i++) html += '<div></div>';
    for(let d=1; d<=30; d++){
      html += d===25 ? `<div class="d wed">25<span class="hz">♥</span><span class="num">25</span></div>` : `<div class="d">${d}</div>`;
    }
    grid.innerHTML = html;
  }
  buildCalendar();
  const calendar = document.getElementById('calendar');
  document.getElementById('revealBtn').addEventListener('click', e=>{
    calendar.classList.add('revealed');
    document.getElementById('revealTxt').innerHTML = '<span lang-en>Date Revealed · 25 November</span><span lang-hi>शुभ तिथि · 25 नवंबर</span>';
    const r = grid.querySelector('.wed').getBoundingClientRect();
    burst(r.left + r.width/2, r.top + r.height/2, 22);
    petalShower(26);
  });

  /* ---------- countdown ---------- */
  const target = new Date('2026-11-25T00:00:00+05:30').getTime();
  const pad = n => String(n).padStart(2,'0');
  function tick(){
    let s = Math.max(0, Math.floor((target - Date.now())/1000));
    const d = Math.floor(s/86400); s%=86400;
    const h = Math.floor(s/3600); s%=3600;
    const m = Math.floor(s/60); s%=60;
    cdD.textContent = d; cdH.textContent = pad(h); cdM.textContent = pad(m); cdS.textContent = pad(s);
    if(target - Date.now() <= 0){
      document.getElementById('cdNote').innerHTML = '<span lang-en>Today is the day! ♥</span><span lang-hi>आज शुभ विवाह का दिन है! ♥</span>';
    }
  }
  const cdD=document.getElementById('cdD'),cdH=document.getElementById('cdH'),cdM=document.getElementById('cdM'),cdS=document.getElementById('cdS');
  tick(); setInterval(tick,1000);

  /* ---------- petals ---------- */
  const petals = document.getElementById('petals');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  function petal(delay){
    const p = document.createElement('div');
    p.className = 'petal' + (Math.random()<.45?' light':'');
    const size = 12 + Math.random()*14;
    p.style.width = size+'px'; p.style.height = size*1.2+'px';
    p.style.left = Math.random()*100+'vw';
    p.style.setProperty('--sway', (Math.random()*120-60)+'px');
    p.style.animationDuration = (8 + Math.random()*8)+'s';
    p.style.animationDelay = (delay||0)+'s';
    petals.appendChild(p);
    p.addEventListener('animationend',()=>p.remove());
  }
  function petalShower(n){ for(let i=0;i<n;i++) petal(Math.random()*1.5); }
  let ambient;
  function startAmbient(){ if(reduce) return; ambient = setInterval(()=>{ if(petals.childElementCount<26) petal(0); }, 900); }

  function burst(x,y,n){
    const glyphs=['♥','✦','❀','✧','♥'];
    for(let i=0;i<n;i++){
      const b=document.createElement('div'); b.className='burst';
      b.textContent=glyphs[i%glyphs.length];
      b.style.left=x+'px'; b.style.top=y+'px';
      b.style.color=['#c2405a','#c9a24b','#8e1426','#e88aa0'][i%4];
      const a=Math.random()*Math.PI*2, r=60+Math.random()*120;
      b.style.setProperty('--dx',Math.cos(a)*r+'px'); b.style.setProperty('--dy',Math.sin(a)*r+'px');
      b.style.setProperty('--r',(Math.random()*360)+'deg');
      document.body.appendChild(b); setTimeout(()=>b.remove(),1500);
    }
  }

  /* ---------- sparkles canvas ---------- */
  const cv = document.getElementById('sparkles'), ctx = cv.getContext('2d');
  let W,H,dpr; const parts=[]; let mode='intro';
  function resize(){ dpr=Math.min(2,devicePixelRatio||1); W=innerWidth; H=innerHeight; cv.width=W*dpr; cv.height=H*dpr; cv.style.width=W+'px'; cv.style.height=H+'px'; ctx.setTransform(dpr,0,0,dpr,0,0); }
  resize(); addEventListener('resize',resize);
  function spawn(){
    if(mode==='intro'){
      // swirl ring around the seal, like a ribbon of light
      const t=Math.random()*Math.PI*2;
      parts.push({orbit:true,t,rad:Math.min(W,H)*(.22+Math.random()*.1),sp:.008+Math.random()*.01,life:1,dec:.004+Math.random()*.006,s:.6+Math.random()*1.8,tilt:.45});
      if(Math.random()<.5) parts.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.2,vy:-.1-Math.random()*.3,life:1,dec:.004+Math.random()*.006,s:.5+Math.random()*1.6});
    } else if(Math.random()<.35){
      parts.push({x:Math.random()*W,y:H+5,vx:(Math.random()-.5)*.25,vy:-.3-Math.random()*.5,life:1,dec:.003+Math.random()*.004,s:.6+Math.random()*1.4});
    }
  }
  function draw(){
    ctx.clearRect(0,0,W,H);
    const max = mode==='intro'?420:90;
    if(parts.length<max){ spawn(); spawn(); }
    const cx=W/2, cy=H/2;
    for(let i=parts.length-1;i>=0;i--){
      const p=parts[i];
      if(p.orbit){ p.t+=p.sp; p.x=cx+Math.cos(p.t)*p.rad*1.25; p.y=cy+Math.sin(p.t)*p.rad*p.tilt + Math.sin(p.t*2)*p.rad*.15; }
      else { p.x+=p.vx; p.y+=p.vy; }
      p.life-=p.dec;
      if(p.life<=0){parts.splice(i,1);continue}
      const a=Math.sin(p.life*Math.PI);
      const g=ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.s*4);
      g.addColorStop(0,`rgba(255,244,214,${a})`); g.addColorStop(.4,`rgba(240,200,120,${a*.5})`); g.addColorStop(1,'rgba(240,200,120,0)');
      ctx.fillStyle=g; ctx.beginPath(); ctx.arc(p.x,p.y,p.s*4,0,Math.PI*2); ctx.fill();
      if(p.s>1.6){ ctx.strokeStyle=`rgba(255,240,200,${a*.7})`; ctx.lineWidth=.6; ctx.beginPath(); ctx.moveTo(p.x-p.s*5,p.y); ctx.lineTo(p.x+p.s*5,p.y); ctx.moveTo(p.x,p.y-p.s*5); ctx.lineTo(p.x,p.y+p.s*5); ctx.stroke(); }
    }
    requestAnimationFrame(draw);
  }
  cv.style.zIndex = 51; // above envelope during intro
  if(!reduce) draw();

  /* ---------- open envelope ---------- */
  const intro = document.getElementById('intro');
  let opened=false;
  function openInvite(){
    if(opened) return; opened=true;
    intro.classList.add('open');
    burst(innerWidth/2, innerHeight/2, 30);
    setTimeout(()=>{ mode='page'; parts.length=0; cv.style.zIndex=2; document.body.classList.add('revealed'); document.body.classList.remove('locked'); petalShower(40); startAmbient(); }, 900);
    setTimeout(()=>intro.classList.add('gone'), 2000);
  }
  intro.addEventListener('click', openInvite);
  intro.addEventListener('keydown', e=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); openInvite(); } });

  /* ---------- reveal cards on scroll ---------- */
  const io = new IntersectionObserver(es=>es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} }),{threshold:.15});
  document.querySelectorAll('.card').forEach(c=>io.observe(c));
})();
</script>
</body>
